# Copy to .env and adjust. Never commit the real .env.
APP_ENV=development

# --- Security ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-real-secret
JWT_EXPIRY=24h
JWT_ISSUER=gamemesh

# --- PostgreSQL ---
POSTGRES_USER=gamemesh
POSTGRES_PASSWORD=gamemesh-dev-password
POSTGRES_DB=gamemesh
POSTGRES_DSN=host=postgres user=gamemesh password=gamemesh-dev-password dbname=gamemesh port=5432 sslmode=disable

# --- Redis ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Service URLs (as seen from the API gateway) ---
PLAYER_SERVICE_URL=http://player:8081
MATCHMAKING_SERVICE_URL=http://matchmaking:8082
LEADERBOARD_SERVICE_URL=http://leaderboard:8083
WEBSOCKET_SERVICE_URL=http://websocket:8084

# --- Rate limiting (gateway) ---
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# --- CORS ---
ALLOWED_ORIGINS=*

# --- Matchmaking ---
MATCH_INTERVAL_SECONDS=5
MATCH_RANK_WINDOW=100
MATCH_BATCH_SIZE=1000
MATCH_MAX_QUEUE_AGE=5m
ROOM_TTL=1h

# --- Distributed tracing (OpenTelemetry) ---
# Set OTEL_ENABLED=false to disable tracing entirely (no exporter is dialed).
OTEL_ENABLED=true
# OTLP/gRPC endpoint of the collector (compose) or backend.
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
# Per-service name override; defaults to the service's own name if unset.
# OTEL_SERVICE_NAME=
# Head sampling: always_on | always_off | traceidratio |
# parentbased_always_on (default) | parentbased_traceidratio.
OTEL_TRACES_SAMPLER=parentbased_always_on
# Ratio used by the *ratio samplers (0.0–1.0).
OTEL_TRACES_SAMPLER_ARG=1.0
SERVICE_VERSION=dev

# --- Grafana (compose only) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
