# Settings shared by every service, as environment variables (envFrom).
# Generated into the ConfigMap gamemesh-config-<hash> by kustomization.yaml:
# the hash changes with the content, so a changed value rolls the pods that
# use it (a plain ConfigMap changed in place left running pods on the old
# values until something else restarted them).
APP_ENV=production
JWT_EXPIRY=24h
JWT_ISSUER=gamemesh
REDIS_ADDR=redis:6379
# The event transport docker-compose runs: NATS JetStream (durable, replay,
# at-least-once). Unset, the services fell back to Redis Pub/Sub, so the
# cluster ran a different transport than the one tested locally.
EVENT_BUS=nats
NATS_URL=nats://nats:4222
# ALLOWED_ORIGINS is ONE list that governs BOTH the WebSocket upgrade's
# origin check (websocket service) AND the HTTP CORS policy of every service
# (pkg/server). Widening it for one widens it for the other. Entries: an exact
# origin, https://*.domain (any subdomain, not the domain itself), host:* (any
# port or none), or * alone. An entry that does not parse stops the services
# at start-up. Requests without an Origin header (non-browser clients) are
# not affected.
ALLOWED_ORIGINS=https://gamemesh.app,https://*.gamemesh.app,http://localhost:*,http://127.0.0.1:*
PLAYER_SERVICE_URL=http://player:8081
MATCHMAKING_SERVICE_URL=http://matchmaking:8082
LEADERBOARD_SERVICE_URL=http://leaderboard:8083
WEBSOCKET_SERVICE_URL=http://websocket:8084
PRESENCE_SERVICE_URL=http://presence:8086
PRESENCE_TTL=45s
PRESENCE_HEARTBEAT_INTERVAL=15s
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
MATCH_INTERVAL_SECONDS=5
MATCH_RANK_WINDOW=100
MATCH_BATCH_SIZE=1000
MATCH_MAX_QUEUE_AGE=5m
ROOM_TTL=1h
AUTO_MIGRATE=true
# No OpenTelemetry collector runs in the cluster in phase 1. Tracing defaults
# to on with localhost:4317, and flushing spans to a collector that is not
# there held every pod's shutdown for ~18 s.
OTEL_ENABLED=false
