{
  "uid": "gamemesh-status",
  "title": "GameMesh status",
  "tags": [
    "gamemesh"
  ],
  "description": "Requests reaching the API gateway (api.gamemesh.app) and open WebSocket connections. Every request is counted once, at the gateway; the services behind it are left out so nothing is counted twice.",
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Requests per second answered by the gateway, over the last minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "gamemesh-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gamemesh-prometheus"
          },
          "expr": "sum(rate(gamemesh_http_requests_total{service=\"gateway\"}[1m]))",
          "legendFormat": "requests/s",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency (p95, p99)",
      "description": "Time the gateway spends on a request, including the service behind it; 95 and 99 % of requests are faster. From the latency histogram's buckets (histogram_quantile), over the last minute. WebSocket sessions are not requests and are not in it.",
      "datasource": {
        "type": "prometheus",
        "uid": "gamemesh-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gamemesh-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gamemesh_http_request_duration_seconds_bucket{service=\"gateway\"}[1m])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "gamemesh-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gamemesh_http_request_duration_seconds_bucket{service=\"gateway\"}[1m])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate",
      "description": "Share of requests the gateway answered with a server error (5xx), over the last minute. Client errors (4xx, such as 404 or a rate-limited 429) are not errors of the service. No data means no requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "gamemesh-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gamemesh-prometheus"
          },
          "expr": "100 * (sum(rate(gamemesh_http_errors_total{service=\"gateway\"}[1m])) or vector(0)) / sum(rate(gamemesh_http_requests_total{service=\"gateway\"}[1m]))",
          "legendFormat": "5xx %",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active connections",
      "description": "WebSocket connections currently open.",
      "datasource": {
        "type": "prometheus",
        "uid": "gamemesh-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gamemesh-prometheus"
          },
          "expr": "sum(gamemesh_websocket_active_connections{service=\"websocket\"})",
          "legendFormat": "connections",
          "range": true,
          "instant": false
        }
      ]
    }
  ]
}
