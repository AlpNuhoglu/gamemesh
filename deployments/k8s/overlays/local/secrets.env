# DEV-ONLY values for the local k3d cluster, the ones the Minikube manifests
# shipped with. Generated into the Secret gamemesh-secrets-<hash> by
# kustomization.yaml. Production has no Secret in the repository: it is
# created in the cluster with values from openssl rand -hex 32 (A9).
JWT_SECRET=minikube-dev-secret-change-me
POSTGRES_USER=gamemesh
POSTGRES_PASSWORD=gamemesh-dev-password
POSTGRES_DB=gamemesh
